+import os
+import subprocess
+import sys
+from unittest.mock import patch
+
+import pytest
+
+from fastapi_cloud_cli.utils.sentry import SENTRY_DSN, init_sentry
+
+
+@pytest.mark.parametrize("state", ["import", "logged_out", "logged_in", "deploy_token"])
+def test_sentry_dependency_boundary(state: str) -> None:
+    code = """
+import importlib.abc
+import sys
+from unittest.mock import patch
+
+class MissingSentry(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname == "sentry_sdk" or fullname.startswith("sentry_sdk."):
+            raise ModuleNotFoundError("blocked sentry_sdk", name=fullname)
+
+assert not any(k == "sentry_sdk" or k.startswith("sentry_sdk.") for k in sys.modules)
+sys.meta_path.insert(0, MissingSentry())
+from fastapi_cloud_cli.utils.sentry import init_sentry
+state = sys.argv[1]
+with patch("fastapi_cloud_cli.utils.sentry.Identity") as identity:
+    identity.return_value.is_logged_in.return_value = state == "logged_in"
+    identity.return_value.has_deploy_token.return_value = state == "deploy_token"
+    if state in ("logged_in", "deploy_token"):
+        try:
+            init_sentry()
+        except ModuleNotFoundError as exc:
+            assert exc.name == "sentry_sdk"
+        else:
+            raise AssertionError("Required SDK import error was suppressed")
+    elif state == "logged_out":
+        init_sentry()
+    assert not any(k == "sentry_sdk" or k.startswith("sentry_sdk.") for k in sys.modules)
+"""
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join(str(p) for p in sys.path if p)
+    result = subprocess.run(
+        [sys.executable, "-c", code, state],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
+@pytest.mark.parametrize(
+    ("logged_in", "deploy_token"), [(True, False), (False, True), (False, False)]
+)
+def test_sentry_auth_decisions_and_integration(
+    logged_in: bool, deploy_token: bool
+) -> None:
+    from sentry_sdk.integrations.typer import TyperIntegration
+
+    with (
+        patch("fastapi_cloud_cli.utils.sentry.Identity") as identity,
+        patch("sentry_sdk.init") as sdk_init,
+    ):
+        identity.return_value.is_logged_in.return_value = logged_in
+        identity.return_value.has_deploy_token.return_value = deploy_token
+        init_sentry()
+        identity.return_value.is_logged_in.assert_called_once_with()
+        if logged_in:
+            identity.return_value.has_deploy_token.assert_not_called()
+        else:
+            identity.return_value.has_deploy_token.assert_called_once_with()
+        if logged_in or deploy_token:
+            sdk_init.assert_called_once()
+            kwargs = sdk_init.call_args.kwargs
+            assert set(kwargs) == {"dsn", "integrations", "send_default_pii"}
+            assert kwargs["dsn"] == SENTRY_DSN
+            assert kwargs["send_default_pii"] is False
+            assert len(kwargs["integrations"]) == 1
+            assert isinstance(kwargs["integrations"][0], TyperIntegration)
+        else:
+            sdk_init.assert_not_called()
