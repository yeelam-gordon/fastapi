  "standard_library": [
    {
      "symbol": "Path.read_bytes",
      "file": "C:\\Program Files\\Python313-arm64\\Lib\\pathlib\\_abc.py",
      "file_sha256": "e37c70955985422905b5ea77572f2e89b5bd45465f5d83a13e35bbc409f603c2",
      "first_line": 621,
      "source": "    def read_bytes(self):\n        \"\"\"\n        Open the file in bytes mode, read it, and close the file.\n        \"\"\"\n        with self.open(mode='rb') as f:\n            return f.read()\n"
    },
