  "own_source": [
    {
      "file": "screen.py",
      "sha256": "3b84a0d3bb75e112ac48508682b0a3f0f495785ad8138a5bf7567330bcdecade",
      "functions": [
        {
          "name": "digest",
          "first_line": 67,
          "source": "def digest(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()"
        },
        {
          "name": "manifest",
          "first_line": 296,
          "source": "def manifest(root):\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        entries = pool.map(\n            lambda path: manifest_entry(path, root), sorted(root.rglob(\"*\"))\n        )\n        return dict(entry for entry in entries if entry is not None)"
        },
        {
          "name": "hash_files",
          "first_line": 304,
          "source": "def hash_files(root, names):\n    names = sorted(names)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        hashes = pool.map(digest, (root / name for name in names))\n        return dict(zip(names, hashes, strict=True))"
        },
        {
          "name": "source_after",
          "first_line": 324,
          "source": "def source_after(source, canonical, inventory, folder):\n    actual = manifest(source)\n    require(\n        all(actual.get(name) == value for name, value in canonical.items()),\n        \"tracked source changed\",\n    )\n    extras = {name: value for name, value in actual.items() if name not in canonical}\n    pycs, retained = {}, {}\n    for name in extras:\n        if name.startswith(\"dist/\"):\n            require(\n                name\n                in {\n                    \"dist/fastapi-0.119.1.tar.gz\",\n                    \"dist/fastapi-0.119.1-py3-none-any.whl\",\n                    \"dist/.gitignore\",\n                },\n                f\"unexpected dist output: {name}\",\n            )\n            if name == \"dist/.gitignore\":\n                require(\n                    (source / name).read_bytes() == b\"*\", \"pinned UV dist ignore file\"\n                )\n        elif name.startswith(\".pdm-build/\"):\n            relative = name.removeprefix(\".pdm-build/\")\n            if relative == \".gitignore\":\n                require(\n                    (source / name).read_bytes() == pdm_ignore_bytes(sys.platform),\n                    \"native stock PDM ignore file\",\n                )\n            else:\n                matches = [\n                    value[\"sha256\"]\n                    for kind in inventory.values()\n                    for member, value in kind.items()\n                    if member == relative or member == \"fastapi-0.119.1/\" + relative\n                ]\n                require(\n                    matches and all(value == extras[name] for value in matches),\n                    f\"PDM output must match exact archive member: {name}\",\n                )\n        elif name.endswith(\".pyc\"):\n            path = Path(name)\n            require(path.parent.name == \"__pycache__\", f\"untyped bytecode: {name}\")\n            original = (\n                path.parent.parent / (path.name.split(\".\")[0] + \".py\")\n            ).as_posix()\n            require(\n                original in canonical and path.name.endswith(\".cpython-313.pyc\"),\n                f\"unexpected bytecode source/tag: {name}\",\n            )\n            data = (source / name).read_bytes()\n            require(\n                data[:4] == importlib.util.MAGIC_NUMBER and len(data) >= 16,\n                f\"invalid bytecode: {name}\",\n            )\n            require(\n                struct.unpack_from(\"<I\", data, 4)[0] == 0,\n                f\"non-default bytecode flags: {name}\",\n            )\n            metadata = (source / original).stat()\n            require(\n                struct.unpack_from(\"<II\", data, 8)\n                == (int(metadata.st_mtime) & 0xFFFFFFFF, metadata.st_size & 0xFFFFFFFF),\n                f\"bytecode source association: {name}\",\n            )\n            pycs[name] = {\n                \"source\": original,\n                \"source_sha256\": canonical[original],\n                \"source_mtime\": int(metadata.st_mtime),\n                \"source_bytes\": metadata.st_size,\n                \"pyc_sha256\": extras[name],\n                \"retained\": \"generated/\" + name,\n                \"magic\": data[:4].hex(),\n                \"flags\": 0,\n            }\n        else:\n            raise RuntimeError(f\"unqualified generated output: {name}\")\n        if not name.startswith(\"dist/\"):\n            target = folder / \"generated\" / name\n            target.parent.mkdir(parents=True, exist_ok=True)\n            shutil.copyfile(source / name, target)\n            require(digest(target) == extras[name], \"generated raw retention differs\")\n            retained[name] = extras[name]\n    return {\n        \"tracked\": canonical,\n        \"outputs\": extras,\n        \"retained_generated\": retained,\n        \"pyc_associations\": pycs,\n    }"
        },
        {
          "name": "retain_archives",
          "first_line": 416,
          "source": "def retain_archives(source, folder):\n    dist = source / \"dist\"\n    expected = {\n        \"fastapi-0.119.1.tar.gz\",\n        \"fastapi-0.119.1-py3-none-any.whl\",\n        \".gitignore\",\n    }\n    require(\n        {path.name for path in dist.iterdir()} == expected,\n        \"exactly two archives and pinned UV ignore required\",\n    )\n    require((dist / \".gitignore\").read_bytes() == b\"*\", \"pinned UV dist ignore file\")\n    artifacts = folder / \"artifacts\"\n    artifacts.mkdir()\n    retained = {}\n    for name in sorted(expected):\n        source_path = dist / name\n        require(\n            source_path.is_file()\n            and not source_path.is_symlink()\n            and not source_path.is_junction(),\n            \"regular dist outputs required\",\n        )\n        target = folder / \"dist.gitignore\" if name == \".gitignore\" else artifacts / name\n        shutil.copyfile(source_path, target)\n        require(digest(source_path) == digest(target), \"raw archive retention differs\")\n        retained[name] = {\n            \"sha256\": digest(target),\n            \"bytes\": target.stat().st_size,\n            \"retained\": str(target.relative_to(folder)),\n        }\n    save(folder / \"dist-output.json\", retained)\n    return artifacts"
        },
        {
          "name": "generated_metadata_proof",
          "first_line": 451,
          "source": "def generated_metadata_proof(inventory, folder, *, platform=None):\n    platform = sys.platform if platform is None else platform\n    receipt, native, command_row = (\n        load(folder / name)\n        for name in (\"ownership.json\", \"native.json\", \"command.json\")\n    )\n    process = receipt[\"actual_process\"]\n    start, end = receipt[\"native_start_ns\"], receipt[\"native_end_ns\"]\n    require(\n        owned_process.Receipt(**receipt).succeeded\n        and native[\"status\"] == \"COMPLETE\"\n        and native[\"returncode\"] == 0,\n        \"successful native lifetime required for generated metadata\",\n    )\n    require(\n        all(type(value) is int for value in (start, end, process[\"pid\"]))\n        and 0 < end - start <= COMMAND_SECONDS * 1_000_000_000\n        and process[\"pid\"] > 0,\n        \"invalid generated metadata native clock/identity\",\n    )\n    require(\n        native[\"start_ns\"] == start\n        and native[\"end_ns\"] == end\n        and associated_process(process, native, command_row[\"argv\"][0], platform)\n        and native[\"argv\"] == command_row[\"argv\"]\n        and command_row[\"argv\"][1] == \"build\"\n        and native[\"cwd\"] == command_row[\"cwd\"]\n        and native[\"environment\"] == command_row[\"environment\"]\n        and native[\"environment\"][\"metadata_profile\"] == {\"SOURCE_DATE_EPOCH\": \"absent\"}\n        and load(folder / \"stdout.actual-process.json\") == process,\n        \"generated metadata native evidence association differs\",\n    )\n    require_reference(inventory, load(folder / \"full-headers.json\"))\n    member = inventory[\"sdist\"][GENERATED_PYPROJECT]\n    pax, mtime = member[\"pax_headers\"], member[\"mtime\"]\n    require(\n        set(pax) == {\"mtime\"}\n        and type(pax[\"mtime\"]) is str\n        and re.fullmatch(r\"[+-]?[0-9]+(?:\\.[0-9]+)?\", pax[\"mtime\"])\n        and type(mtime) in (float, int)\n        and math.isfinite(mtime),\n        \"default generated pyproject PAX/finite mtime required\",\n    )\n    decimal = Decimal(pax[\"mtime\"])\n    require(\n        decimal.is_finite() and decimal == Decimal(str(mtime)),\n        \"generated pyproject PAX/parser mtime differs\",\n    )\n    lower, upper = utc_window_ns(process, start, end, platform=platform)\n    numerator, denominator = decimal.as_integer_ratio()\n    require(\n        lower * denominator <= numerator * 1_000_000_000 <= upper * denominator,\n        \"generated pyproject mtime outside actual UV UTC lifetime\",\n    )\n    retained = load(folder / \"dist-output.json\")\n    paths = [\n        \"ownership.json\",\n        \"native.json\",\n        \"command.json\",\n        \"stdout\",\n        \"stderr\",\n        \"stdout.actual-process.json\",\n        \"full-headers.json\",\n        \"dist-output.json\",\n    ]\n    bindings = {\n        name: digest(folder / name)\n        for name in paths + [item[\"retained\"] for item in retained.values()]\n    }\n    require(\n        all(bindings[item[\"retained\"]] == item[\"sha256\"] for item in retained.values()),\n        \"generated metadata retained raw bytes differ\",\n    )\n    return {\n        \"profile\": \"stock PDM 2.5.0 generated pyproject default timestamp only\",\n        \"backend_wheel_sha256\": WHEEL_SHA,\n        \"member\": GENERATED_PYPROJECT,\n        \"raw_header\": member,\n        \"actual_process\": process,\n        \"native_QPC_ns\" if platform == \"win32\" else \"native_monotonic_ns\": [start, end],\n        \"UTC_window_ns\": [lower, upper],\n        \"platform\": platform,\n        \"clock_basis\": \"Explicit platform birth UTC plus owned native duration; Darwin quantization only.\",\n        \"bindings\": bindings,\n    }"
        },
        {
          "name": "execute",
          "first_line": 592,
          "source": "def execute(args, canonical, deadline, envs, argv, runtime_guard):\n    rows, reference, reference_folder = [], None, None\n    live = args.output / \"canonical-source\"\n    for index, (arm, measured, pair) in enumerate(schedule()):\n        row_started = time.perf_counter()\n        room(deadline, COMMAND_SECONDS + GUARDIAN_ALLOWANCE + AUDIT_RESERVE)\n        folder = args.output / f\"build-{index:02}-{arm}\"\n        folder.mkdir()\n        runtime_guard.before_row(arm, measured, pair, folder)\n        if live.exists():\n            shutil.rmtree(live)\n        extract(args.output / \"source.tar\", live)\n        before = manifest(live)\n        save(folder / \"source-before.json\", before)\n        require(before == canonical, \"fresh source manifest differs\")\n        spec = folder / \"command.json\"\n        save(\n            spec,\n            {\n                \"argv\": argv,\n                \"cwd\": str(live),\n                \"environment\": environment_evidence(envs[arm]),\n                \"arm\": arm,\n                \"measured\": measured,\n                \"pair\": pair,\n            },\n        )\n        room(deadline, COMMAND_SECONDS + GUARDIAN_ALLOWANCE + AUDIT_RESERVE)\n        started = time.perf_counter()\n        receipt, native = run_native(\n            argv,\n            cwd=live,\n            env=envs[arm],\n            stdout_path=folder / \"stdout\",\n            stderr_path=folder / \"stderr\",\n            timeout=COMMAND_SECONDS,\n            native_clock=True,\n        )\n        save(folder / \"ownership.json\", dataclasses.asdict(receipt))\n        save(\n            folder / \"native.json\",\n            {\n                **native,\n                \"environment\": environment_evidence(native[\"environment\"]),\n            },\n        )\n        require(receipt.succeeded, \"fatal receipt; no next command or value\")\n        require(\n            native[\"status\"] == \"COMPLETE\" and native[\"returncode\"] == 0,\n            \"native command incomplete\",\n        )\n        require(\n            native[\"argv\"] == argv\n            and native[\"cwd\"] == str(live)\n            and native[\"environment\"] == envs[arm],\n            \"actual CLI/environment differs\",\n        )\n        require(\n            associated_process(\n                receipt.actual_process, native, str(args.uv), sys.platform\n            ),\n            \"native association failed\",\n        )\n        require(\n            receipt.native_start_ns\n            == native[\"start_ns\"]\n            < native[\"end_ns\"]\n            == receipt.native_end_ns,\n            \"native clock not identical to owned clock\",\n        )\n        seconds = (native[\"end_ns\"] - native[\"start_ns\"]) / 1e9\n        require(seconds <= COMMAND_SECONDS, \"native command cap exceeded\")\n        room(deadline, AUDIT_RESERVE)\n        audit_started = time.perf_counter()\n        inventory, content = archive_audit(\n            live, canonical, reference, folder, reference_folder\n        )\n        source_proof = source_after(live, canonical, inventory, folder)\n        save(folder / \"source-after.json\", source_proof)\n        require(\n            all(\n                source_proof[\"outputs\"].get(\"dist/\" + name) == metadata[\"sha256\"]\n                for name, metadata in content.items()\n            ),\n            \"source dist and retained raw archive association differs\",\n        )\n        if reference is None:\n            reference, reference_folder = inventory, folder\n        save(folder / \"full-headers.json\", inventory)\n        save(folder / \"content-record.json\", content)\n        runtime_guard.after_row(arm, measured, pair, folder)\n        rows.append(\n            {\n                \"index\": index,\n                \"folder\": folder.name,\n                \"arm\": arm,\n                \"measured\": measured,\n                \"pair\": pair,\n                \"seconds\": seconds,\n                \"prelaunch_seconds\": started - row_started,\n                \"status\": \"VALID\",\n                \"owned_wall_seconds\": audit_started - started,\n                \"audit_seconds\": time.perf_counter() - audit_started,\n                \"command_sha256\": digest(spec),\n                \"ownership_sha256\": digest(folder / \"ownership.json\"),\n                \"native_sha256\": digest(folder / \"native.json\"),\n                \"headers_sha256\": digest(folder / \"full-headers.json\"),\n                \"content_sha256\": digest(folder / \"content-record.json\"),\n                \"source_before_sha256\": digest(folder / \"source-before.json\"),\n                \"source_after_sha256\": digest(folder / \"source-after.json\"),\n                \"generated_metadata_sha256\": digest(\n                    folder / \"generated-metadata-proof.json\"\n                ),\n            }\n        )\n        save(args.output / \"rows.json\", rows)\n        room(deadline, GUARDIAN_ALLOWANCE)\n    return rows"
        }
      ]
    },
    {
      "file": "runtime_bytecode.py",
      "sha256": "a04b79a96b7e2daf5616fe4c8064c308f2eecb74a91a7ef099f22d7f84a0e889",
      "functions": [
        {
          "name": "runtime_entry",
          "first_line": 54,
          "source": "def runtime_entry(path, root):\n    require(\n        not path.is_symlink() and not path.is_junction(),\n        \"runtime symlink/junction\",\n    )\n    name = path.relative_to(root).as_posix()\n    if path.is_dir():\n        return name, None, None\n    before = path.stat()\n    require(stat.S_ISREG(before.st_mode), \"nonregular runtime output\")\n    data = path.read_bytes()\n    after = path.stat()\n    fields = (\"st_size\", \"st_mtime_ns\", \"st_ctime_ns\", \"st_mode\", \"st_ino\")\n    require(\n        all(getattr(before, field) == getattr(after, field) for field in fields),\n        \"runtime changed during snapshot\",\n    )\n    record = {\n        \"sha256\": hashlib.sha256(data).hexdigest(),\n        \"size\": before.st_size,\n        \"mtime_ns\": before.st_mtime_ns,\n        \"ctime_ns\": before.st_ctime_ns,\n        \"mode\": before.st_mode,\n        \"inode\": before.st_ino,\n        \"timestamp\": int(before.st_mtime) & 0xFFFFFFFF,\n    }\n    return name, record, data if path.suffix.lower() == \".pyc\" else None"
        },
        {
          "name": "scan",
          "first_line": 177,
          "source": "def scan(self):\n        if getattr(self, \"link_policy\", None) is not None:\n            return self.link_policy.scan(self.roots, self.inputs, runtime_entry)\n        files, directories, raw = {}, {}, {}\n        with ThreadPoolExecutor(max_workers=4) as pool:\n            for declared, root in self.roots.items():\n                require(\n                    Path(declared).resolve(strict=True) == root,\n                    \"runtime root binding changed\",\n                )\n                files[declared], raw[declared], directories[declared] = {}, {}, []\n                entries = pool.map(runtime_entry, sorted(root.rglob(\"*\")), repeat(root))\n                for name, record, data in entries:\n                    if record is None:\n                        directories[declared].append(name)\n                    else:\n                        files[declared][name] = record\n                        if data is not None:\n                            raw[declared][name] = data\n        return {\n            \"files\": files,\n            \"directories\": directories,\n            \"inputs\": self.inputs(),\n        }, raw"
        }
      ]
    },
    {
      "file": "runtime_links.py",
      "sha256": "35a0d36eec99c9f68c42d001662bd58772112959d33db43a965d19a5c4575813",
      "functions": [
        {
          "name": "scan",
          "first_line": 122,
          "source": "def scan(self, roots, inputs, regular_entry):\n        require(\n            set(roots) == set(self.rules)\n            and all(str(root) == declared for declared, root in roots.items()),\n            \"runtime policy root association\",\n        )\n        files, directories, raw, links, ancestors = {}, {}, {}, {}, {}\n        paths = []\n        for declared, root in roots.items():\n            require(root.resolve(strict=True) == root, \"runtime root binding changed\")\n            for ancestor in reversed((root, *root.parents)):\n                ancestors[str(ancestor)] = directory_identity(ancestor)\n            files[declared], directories[declared], raw[declared], links[declared] = (\n                {},\n                [],\n                {},\n                {},\n            )\n            pending = [root]\n            while pending:\n                parent = pending.pop()\n                for path in sorted(parent.iterdir()):\n                    name = path.relative_to(root).as_posix()\n                    require(not path.is_junction(), \"runtime junction\")\n                    value = path.lstat()\n                    if stat.S_ISLNK(value.st_mode):\n                        require(name in self.rules[declared], \"unexpected runtime link\")\n                        require(value.st_nlink == 1, \"runtime link hardlink\")\n                        target, target_root, target_name = self.rules[declared][name]\n                        observed_target = os.readlink(path)\n                        require(observed_target == target, \"runtime raw link target\")\n                        # No directory traversal or general-purpose link resolution.\n                        # The complete allowed graph closes to this one regular member.\n                        links[declared][name] = {\n                            \"path\": str(path),\n                            \"raw_target\": observed_target,\n                            \"lstat\": metadata(value),\n                            \"target_root\": target_root,\n                            \"target_name\": target_name,\n                        }\n                    elif stat.S_ISDIR(value.st_mode):\n                        directories[declared].append(name)\n                        ancestors[str(path)] = directory_identity(path)\n                        pending.append(path)\n                    else:\n                        require(stat.S_ISREG(value.st_mode), \"nonregular runtime input\")\n                        paths.append((declared, root, path))\n            directories[declared].sort()\n            require(\n                set(links[declared]) == set(self.rules[declared]),\n                \"missing runtime links\",\n            )\n\n        def read(item):\n            declared, root, path = item\n            before = path.lstat()\n            require(\n                stat.S_ISREG(before.st_mode) and before.st_nlink == 1,\n                \"runtime regular target type/hardlink\",\n            )\n            name, record, data = regular_entry(path, root)\n            after = path.lstat()\n            require(\n                metadata(before) == metadata(after) and not path.is_junction(),\n                \"runtime target replaced during snapshot\",\n            )\n            record.update(device=before.st_dev, nlink=before.st_nlink)\n            return declared, name, record, data\n\n        with ThreadPoolExecutor(max_workers=4) as pool:\n            for declared, name, record, data in pool.map(read, paths):\n                files[declared][name] = record\n                if data is not None:\n                    raw[declared][name] = data\n        for declared, entries in links.items():\n            for name, record in entries.items():\n                target = files[record[\"target_root\"]].get(record[\"target_name\"])\n                require(target is not None, \"runtime link target is not sealed regular\")\n                record[\"target\"] = dict(target)\n                path = Path(declared) / name\n                require(\n                    metadata(path.lstat()) == record[\"lstat\"]\n                    and os.readlink(path) == record[\"raw_target\"]\n                    and not path.is_junction(),\n                    \"runtime link changed during snapshot\",\n                )\n                target_path = Path(record[\"target_root\"]) / record[\"target_name\"]\n                require(\n                    all(\n                        target[key] == value\n                        for key, value in metadata(target_path.lstat()).items()\n                    )\n                    and not target_path.is_junction(),\n                    \"runtime link target replaced during snapshot\",\n                )\n        for name, identity in ancestors.items():\n            require(\n                directory_identity(Path(name)) == identity,\n                \"runtime ancestor changed during snapshot\",\n            )\n        return {\n            \"files\": files,\n            \"directories\": directories,\n            \"links\": links,\n            \"ancestors\": ancestors,\n            \"inputs\": inputs(),\n        }, raw"
        }
      ]
    },
    {
      "file": "archive_headers.py",
      "sha256": "f02711558e43a0d2592c403ffba88d6f2690e8b1350ddd38a2da88f361865b0c",
      "functions": [
        {
          "name": "full_inventory",
          "first_line": 53,
          "source": "def full_inventory(directory):\n    paths = list(directory.iterdir())\n    wheels = [path for path in paths if path.name.endswith(\".whl\")]\n    sdists = [path for path in paths if path.name.endswith(\".tar.gz\")]\n    if len(paths) != 2 or len(wheels) != 1 or len(sdists) != 1:\n        raise ValueError(\"Exactly one sdist and one wheel required\")\n    result = {\"sdist\": {}, \"wheel\": {}}\n    with tarfile.open(sdists[0]) as archive:\n        for entry in archive:\n            if not entry.isfile() or entry.name in result[\"sdist\"]:\n                raise ValueError(\"Duplicate/nonregular tar member\")\n            value = {\n                name: getattr(entry, name) for name in TAR_FIELDS - {\"sha256\", \"type\"}\n            }\n            value[\"sha256\"] = hashlib.sha256(\n                archive.extractfile(entry).read()\n            ).hexdigest()\n            value[\"type\"] = entry.type.decode()\n            result[\"sdist\"][entry.name] = value\n    with zipfile.ZipFile(wheels[0]) as archive:\n        for entry in archive.infolist():\n            if entry.filename in result[\"wheel\"]:\n                raise ValueError(\"Duplicate wheel member\")\n            value = {\n                name: getattr(entry, name)\n                for name in WHEEL_FIELDS - {\"sha256\", \"comment\", \"extra\"}\n            }\n            value[\"sha256\"] = hashlib.sha256(archive.read(entry)).hexdigest()\n            value[\"comment\"], value[\"extra\"] = entry.comment.hex(), entry.extra.hex()\n            result[\"wheel\"][entry.filename] = value\n    return json.loads(json.dumps(result))"
        }
      ]
    },
    {
      "file": "artifact_gate.py",
      "sha256": "7074e6697002d0e21bb131f551a932e9a6cf1a4ed946cb7bac03daecfa5033be",
      "functions": [
        {
          "name": "archive_members",
          "first_line": 21,
          "source": "def archive_members(path, source, canonical):\n    members = {}\n    if path.suffix == \".whl\":\n        with zipfile.ZipFile(path) as archive:\n            entries = archive.infolist()\n            require(\n                len(entries) == len(set(archive.namelist())), \"duplicate wheel members\"\n            )\n            for entry in entries:\n                data = archive.read(entry)\n                members[entry.filename] = {\n                    \"sha256\": digest(data),\n                    \"bytes\": len(data),\n                    \"mode\": entry.external_attr >> 16,\n                    \"directory\": entry.is_dir(),\n                }\n                if entry.filename in canonical:\n                    require(\n                        digest(data) == canonical[entry.filename],\n                        f\"wheel source tie: {entry.filename}\",\n                    )\n            wheels = [name for name in members if name.endswith(\".dist-info/WHEEL\")]\n            require(len(wheels) == 1, \"unique WHEEL required\")\n            require(\n                \"Generator: pdm-backend (2.5.0)\" in archive.read(wheels[0]).decode(),\n                \"installed backend Generator must be pdm-backend (2.5.0)\",\n            )\n            records = [name for name in members if name.endswith(\".dist-info/RECORD\")]\n            require(len(records) == 1, \"unique RECORD required\")\n            rows = list(csv.reader(io.StringIO(archive.read(records[0]).decode())))\n            require(\n                len(rows) == len(members) and {row[0] for row in rows} == set(members),\n                \"RECORD member coverage\",\n            )\n            for name, recorded, size in rows:\n                if name == records[0]:\n                    require(not recorded and not size, \"RECORD self entry\")\n                else:\n                    data = archive.read(name)\n                    expected = (\n                        \"sha256=\"\n                        + base64.urlsafe_b64encode(hashlib.sha256(data).digest())\n                        .rstrip(b\"=\")\n                        .decode()\n                    )\n                    require(\n                        recorded == expected and int(size) == len(data),\n                        f\"RECORD mismatch: {name}\",\n                    )\n    else:\n        with tarfile.open(path) as archive:\n            entries = archive.getmembers()\n            require(\n                len(entries) == len({entry.name for entry in entries}),\n                \"duplicate sdist members\",\n            )\n            pyprojects = []\n            for entry in entries:\n                data = archive.extractfile(entry).read() if entry.isfile() else b\"\"\n                members[entry.name] = {\n                    \"sha256\": digest(data),\n                    \"bytes\": len(data),\n                    \"mode\": entry.mode,\n                    \"type\": entry.type.decode(),\n                    \"linkname\": entry.linkname,\n                }\n                relative = entry.name.split(\"/\", 1)[-1]\n                if relative == \"pyproject.toml\":\n                    expected = tomllib.loads(\n                        (source / relative).read_text(encoding=\"utf-8\")\n                    )\n                    expected[\"project\"][\"dynamic\"] = []\n                    expected[\"project\"][\"version\"] = \"0.119.1\"\n                    require(\n                        tomllib.loads(data.decode(\"utf-8\")) == expected,\n                        \"unexpected generated pyproject metadata\",\n                    )\n                    pyprojects.append(entry.name)\n                elif relative in canonical:\n                    require(\n                        digest(data) == canonical[relative],\n                        f\"sdist source tie: {relative}\",\n                    )\n            require(len(pyprojects) == 1, \"unique generated pyproject required\")\n    return members"
        }
      ]
    },
    {
      "file": "owned_process.py",
      "sha256": "595e46cedfcd270ccc6b1dfc3337034595096f0f58e70188e844bfc0cffaa261",
      "functions": [
        {
          "name": "_supervise",
          "first_line": 280,
          "source": "def _supervise():\n    spec = json.load(sys.stdin)\n    result = {\"owned\": False, \"started\": None, \"returncode\": None, \"timed_out\": False}\n    try:\n        if _WINDOWS:\n            api = _windows()\n            handle = _checked(api.OpenJobObjectW(1, False, spec[\"job\"]))\n            try:\n                _checked(api.AssignProcessToJobObject(handle, api.GetCurrentProcess()))\n            finally:\n                _checked(api.CloseHandle(handle))\n        result[\"owned\"] = True\n        with open(spec[\"stdout\"], \"wb\") as out:\n            same = spec[\"stdout\"] == spec[\"stderr\"]\n            err = out if same else open(spec[\"stderr\"], \"wb\")\n            try:\n                result[\"started\"] = time.perf_counter()\n                if spec.get(\"native_clock\"):\n                    result[\"native_start_ns\"] = time.perf_counter_ns()\n                child = subprocess.Popen(spec[\"argv\"], stdout=out, stderr=err)\n                if _WINDOWS:\n                    module_spec = importlib.util.spec_from_file_location(\n                        \"owned_cli_identity\",\n                        Path(__file__).with_name(\"cli_identity.py\"),\n                    )\n                    module = importlib.util.module_from_spec(module_spec)\n                    module_spec.loader.exec_module(module)\n                    result[\"actual_process\"] = module.popen_identity(child)\n                    progress = Path(spec[\"stdout\"]).with_suffix(\".actual-process.json\")\n                    staged = progress.with_suffix(\".new\")\n                    staged.write_text(\n                        json.dumps(result[\"actual_process\"]), encoding=\"utf-8\"\n                    )\n                    os.replace(staged, progress)\n                elif sys.platform == \"darwin\" and spec.get(\"native_clock\"):\n                    module_spec = importlib.util.spec_from_file_location(\n                        \"owned_darwin_identity\",\n                        Path(__file__).resolve().with_name(\"darwin_identity.py\"),\n                    )\n                    module = importlib.util.module_from_spec(module_spec)\n                    sys.modules[module_spec.name] = module\n                    module_spec.loader.exec_module(module)\n                    result[\"actual_process\"] = asdict(\n                        module.capture_child_identity(child, spec[\"argv\"][0])\n                    )\n                    progress = Path(spec[\"stdout\"]).with_suffix(\".actual-process.json\")\n                    staged = progress.with_suffix(\".new\")\n                    staged.write_text(\n                        json.dumps(result[\"actual_process\"]), encoding=\"utf-8\"\n                    )\n                    os.replace(staged, progress)\n                try:\n                    remaining = spec[\"timeout\"] - (\n                        time.perf_counter() - result[\"started\"]\n                    )\n                    result[\"returncode\"] = child.wait(timeout=max(0, remaining))\n                except subprocess.TimeoutExpired:\n                    result[\"timed_out\"] = True\n            finally:\n                if not same:\n                    err.close()\n    except BaseException as error:\n        result[\"error\"] = f\"{type(error).__name__}: {error}\"\n    print(json.dumps(result), flush=True)"
        },
        {
          "name": "run_owned",
          "first_line": 346,
          "source": "def run_owned(\n    argv, *, cwd, env, stdout_path, stderr_path, timeout=120, native_clock=False\n) -> Receipt:\n    \"\"\"Run a fixed non-detaching command; caller must stop sampling unless succeeded.\"\"\"\n    if not math.isfinite(timeout) or timeout <= 0:\n        raise ValueError(\"timeout must be positive and finite\")\n    clock = time.perf_counter()\n    job = process = None\n    data, errors, liveness = {}, [], []\n    survivors = None\n    clean = False\n    native_end_ns = None\n    try:\n        name = \"arm-owned-\" + uuid.uuid4().hex\n        job = _Job(name) if _WINDOWS else None\n        spec = {\n            \"argv\": [str(v) for v in argv],\n            \"stdout\": str(Path(stdout_path).resolve()),\n            \"stderr\": str(Path(stderr_path).resolve()),\n            \"timeout\": timeout,\n            \"job\": name,\n            \"native_clock\": native_clock,\n        }\n        interpreter = (\n            str(Path(sys.base_prefix) / \"python.exe\") if _WINDOWS else sys.executable\n        )\n        process = subprocess.Popen(\n            [interpreter, \"-I\", \"-B\", str(Path(__file__).resolve()), \"--supervisor\"],\n            cwd=cwd,\n            env=env,\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            start_new_session=not _WINDOWS,\n        )\n        output, diagnostic = process.communicate(json.dumps(spec), timeout=timeout + 10)\n        data = json.loads(output)\n        if \"error\" in data:\n            errors.append(data[\"error\"])\n        if process.returncode or diagnostic or not data[\"owned\"]:\n            raise RuntimeError(\"Supervisor ownership/setup failed: \" + diagnostic)\n    except Exception as error:\n        errors.append(f\"{type(error).__name__}: {error}\")\n        errors.extend(getattr(error, \"__notes__\", ()))\n        if isinstance(error, subprocess.TimeoutExpired):\n            data[\"timed_out\"] = True\n    finally:\n        try:\n            if process is not None:\n                if process.poll() is None:\n                    process.kill()\n                    process.wait(timeout=5)\n\n                def alive():\n                    if job:\n                        return job.alive() and job.live_members(process.pid, liveness)\n                    return _group_alive(process.pid)\n\n                survivors = alive()\n                if survivors:\n                    if job:\n                        job.kill()\n                    else:\n                        os.killpg(process.pid, signal.SIGKILL)\n                deadline = time.perf_counter() + 5\n                while alive() and time.perf_counter() < deadline:\n                    time.sleep(0.01)\n                clean = not alive()\n                if clean and native_clock and data.get(\"native_start_ns\") is not None:\n                    native_end_ns = time.perf_counter_ns()\n                if not clean:\n                    errors.append(\"Owned family did not drain before cleanup deadline\")\n        except Exception as error:\n            errors.append(f\"cleanup {type(error).__name__}: {error}\")\n            errors.extend(getattr(error, \"__notes__\", ()))\n        finally:\n            if job:\n                try:\n                    job.close()\n                except Exception as error:\n                    clean = False\n                    errors.append(f\"close {type(error).__name__}: {error}\")\n            if process:\n                for stream in (process.stdin, process.stdout, process.stderr):\n                    try:\n                        stream.close()\n                    except Exception as error:\n                        clean = False\n                        errors.append(f\"pipe close {type(error).__name__}: {error}\")\n    ended = time.perf_counter()\n    started = data.get(\"started\")\n    wall = ended - started if started is not None else None\n    infrastructure = started - clock if started is not None else None\n    if data and started is None:\n        infrastructure = ended - clock\n    return Receipt(\n        data.get(\"returncode\"),\n        data.get(\"timed_out\", False) or (wall is not None and wall > timeout),\n        wall,\n        infrastructure,\n        data.get(\"owned\", False),\n        survivors,\n        clean,\n        tuple(errors),\n        tuple(liveness),\n        data.get(\"native_start_ns\"),\n        native_end_ns,\n        data.get(\"actual_process\"),\n    )"
        }
      ]
    }
  ],
  "historical_owner_inference": "None. Parent current RestartManager empty list does not identify the failure-time locker or rule out a historical own leak."
}
