diff --git a/Lib/pathlib/_local.py b/Lib/pathlib/_local.py
index 0188e7c..a96251e 100644
--- a/Lib/pathlib/_local.py
+++ b/Lib/pathlib/_local.py
@@ -378,6 +378,19 @@ def relative_to(self, other, /, *_deprecated, walk_up=False):
             other = self.with_segments(other, *_deprecated)
         elif not isinstance(other, PurePath):
             other = self.with_segments(other)
+        stock_types = (PurePosixPath, PureWindowsPath, PosixPath, WindowsPath)
+        if (not walk_up and not _deprecated
+                and any(type(self) is cls for cls in stock_types)
+                and any(type(other) is cls for cls in stock_types)
+                and self.parser is other.parser):
+            size = len(other._tail)
+            if size <= len(self._tail):
+                prefix = self._format_parsed_parts(
+                    self.drive, self.root, self._tail[:size]) or '.'
+                if self.parser is not posixpath:
+                    prefix = prefix.lower()
+                if prefix == other._str_normcase:
+                    return self._from_parsed_parts('', '', self._tail[size:])
         for step, path in enumerate(chain([other], other.parents)):
             if path == self or path in self.parents:
                 break
