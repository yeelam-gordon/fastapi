+    def test_relative_to_lexical_boundaries(self):
+        P = self.cls
+        self.assertEqual(P('a/./b/../Leaf').relative_to(P('a/b')), P('../Leaf'))
+        self.assertEqual(P('a/Leaf').relative_to(P()), P('a/Leaf'))
+        for path, base in [('ab/Leaf', 'a'), ('/a/Leaf', '//a'),
+                           ('/a/Leaf', 'a')]:
+            with self.subTest(path=path, base=base):
+                self.assertRaises(ValueError, P(path).relative_to, P(base))
+
+    @needs_windows
+    def test_relative_to_unicode_whole_string_lower(self):
+        P = self.cls
+        for path, base, expected in [
+                ('C:Σ', 'C:ς', '.'),
+                ('C:Σ/Leaf', 'C:ς', 'Leaf'),
+                ('C:/İ/Leaf', 'c:/i\u0307', 'Leaf'),
+                ('C:/Σ/Leaf', 'c:/σ', 'Leaf')]:
+            with self.subTest(path=path, base=base):
+                self.assertEqual(str(P(path).relative_to(P(base))), expected)
+        self.assertRaises(ValueError, P('C:/Σ/Leaf').relative_to, P('c:/ς'))
+        self.assertRaises(ValueError, P('C:Σ/Leaf').relative_to, P('C:/ς'))
+
+    def test_relative_to_subclass_factory_fallback(self):
+        calls = []
+
+        class P(self.cls):
+            def with_segments(self, *parts):
+                calls.append(parts)
+                result = type(self)(*parts)
+                result.marker = 42
+                return result
+
+        result = P('a/b/Leaf').relative_to(P('a'))
+        self.assertIs(type(result), P)
+        self.assertEqual(result.marker, 42)
+        self.assertGreater(len(calls), 1)
+
+    def test_relative_to_metaclass_equality_fallback(self):
+        class EqualMeta(type):
+            def __eq__(cls, other):
+                return True
+
+        class P(type(self.cls()), metaclass=EqualMeta):
+            def __eq__(self, other):
+                return False
+
+        self.assertRaises(ValueError, P('a/b/Leaf').relative_to, self.cls('a'))
+        self.assertRaises(ValueError, self.cls('a/b/Leaf').relative_to, P('a'))
+
+    def test_relative_to_metaclass_parents_fallback(self):
+        class EqualMeta(type):
+            def __eq__(cls, other):
+                return True
+
+        class P(type(self.cls()), metaclass=EqualMeta):
+            @property
+            def parents(self):
+                raise LookupError('subclass parents accessed')
+
+        self.assertRaises(LookupError, P('a/b/Leaf').relative_to, self.cls('a'))
+        self.assertRaises(LookupError, self.cls('a/b/Leaf').relative_to, P('a'))
+
+    def test_relative_to_walk_up_flag_evaluation(self):
+        calls = []
+
+        class Flag:
+            def __init__(self, value):
+                self.value = value
+
+            def __bool__(self):
+                calls.append(self.value)
+                if self.value is None:
+                    raise LookupError('flag evaluated')
+                return self.value
+
+        P = self.cls
+        for value in (None, False, True):
+            calls.clear()
+            self.assertEqual(P('a/Leaf').relative_to(P('a'), walk_up=Flag(value)),
+                             P('Leaf'))
+            self.assertEqual(calls, [])
+        self.assertRaises(LookupError, P('a/Leaf').relative_to, P('other'),
+                          walk_up=Flag(None))
+        self.assertEqual(calls, [None])
+        calls.clear()
+        self.assertRaises(ValueError, P('a/Leaf').relative_to, P('other'),
+                          walk_up=Flag(False))
+        self.assertEqual(calls, [False])
+        calls.clear()
+        self.assertEqual(P('a/Leaf').relative_to(P('other'), walk_up=Flag(True)),
+                         P('../a/Leaf'))
+        self.assertEqual(calls, [True])
+
+    def test_relative_to_stock_default_error_message(self):
+        P = self.cls
+        for path, base in [('a/Leaf', 'other'), ('a', 'a/Leaf'),
+                           ('/a/Leaf', 'a'), ('a', '/a'), ('ab/Leaf', 'a')]:
+            p, q = P(path), P(base)
+            with self.subTest(path=path, base=base):
+                with self.assertRaises(ValueError) as caught:
+                    p.relative_to(q)
+                self.assertEqual(str(caught.exception),
+                                 f"{str(p)!r} is not in the subpath of {str(q)!r}")
+
+    def test_relative_to_mixed_stock_classes(self):
+        pure = pathlib.PureWindowsPath if os.name == 'nt' else pathlib.PurePosixPath
+        concrete = pathlib.WindowsPath if os.name == 'nt' else pathlib.PosixPath
+        for left, right in [(pure, concrete), (concrete, pure)]:
+            result = left('a/Leaf').relative_to(right('a'))
+            self.assertIs(type(result), left)
+            self.assertEqual(str(result), 'Leaf')
+            self.assertRaises(ValueError, left('a/Leaf').relative_to, right('/a'))
+
