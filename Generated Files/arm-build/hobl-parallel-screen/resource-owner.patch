+import pytest
+
+
+@pytest.hookimpl(tryfirst=True)
+def pytest_collection_modifyitems(config, items):
+    argv = tuple(getattr(config, "workerinput", {}).get("mainargv", ()))
+    if config.getoption("dist", default=None) != "loadgroup" and "--dist=loadgroup" not in argv and not any(
+        left == "--dist" and right == "loadgroup" for left, right in zip(argv, argv[1:])
+    ):
+        return
+    shared = {"tests/test_application.py", "tests/test_path.py", "tests/test_query.py"}
+    workdir = {
+        "tests/test_tutorial/test_additional_responses/test_tutorial002.py",
+        "tests/test_tutorial/test_additional_responses/test_tutorial004.py",
+        "tests/test_tutorial/test_background_tasks/test_tutorial001.py",
+        "tests/test_tutorial/test_background_tasks/test_tutorial002.py",
+        "tests/test_tutorial/test_events/test_tutorial002.py",
+    }
+    for item in items:
+        if item.get_closest_marker("xdist_group") is None:
+            filename = item.nodeid.split("::", 1)[0]
+            group = "shared-main-app" if filename in shared else (
+                "workdir_lock" if filename in workdir else filename
+            )
+            item.add_marker(pytest.mark.xdist_group(name=group))
